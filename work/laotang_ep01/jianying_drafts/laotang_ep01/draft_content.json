                "content": "{\"styles\": [{\"fill\": {\"alpha\": 1.0, \"content\": {\"render_type\": \"solid\", \"solid\": {\"alpha\": 1.0, \"color\": [1.0, 1.0, 1.0]}}}, \"range\": [0, 13], \"size\": 5, \"bold\": false, \"italic\": false, \"underline\": false, \"strokes\": []}], \"text\": \"我妈留给我的，只有这锅汤。\"}",
